# ================= Discord =================
# Your bot token from https://discord.com/developers/applications
BOT_TOKEN=
# Your application (bot) ID
CLIENT_ID=
# Optional: a guild/server ID for instant command registration while developing
GUILD_ID=

# ================= NodeLink (bundled audio server) =================
# `npm start` boots NodeLink AND the bot together — no Java needed.
# Locally it listens on 127.0.0.1:3000; on Render it binds 0.0.0.0:$PORT automatically.
# These are optional overrides:
# NODELINK_HOST=127.0.0.1
# NODELINK_PORT=3000
NODELINK_PASSWORD=youshallnotpass

# The launcher also exports these to NodeLink so the bind address always matches
# what the bot connects to, even if nodelink/config.ts shadows nodelink/config.js:
# NODELINK_SERVER_HOST=127.0.0.1
# NODELINK_SERVER_PORT=3000
# NODELINK_SERVER_PASSWORD=youshallnotpass

# ================= Keepalive (bot -> NodeLink ping) =================
# Pings the audio server every interval to keep the connection warm and detect
# outages early. Set KEEPALIVE_ENABLED=false to disable, or KEEPALIVE_URL to
# additionally self-ping an external URL (e.g. your Render web service).
# KEEPALIVE_ENABLED=true
# KEEPALIVE_INTERVAL_MS=60000
# KEEPALIVE_URL=

# ================= YouTube OAuth (TV client) =================
# 1. With no token set, `npm start` prints a google.com/device URL + code.
#    Sign in with a BURNER Google account and NodeLink prints the refresh token.
# 2. Put the token below (locally and on Render), and set GETOAUTHTOKEN=false
#    everywhere — otherwise NodeLink re-runs the sign-in flow and exits on boot.
# NODELINK_SOURCES_YOUTUBE_CLIENTS_SETTINGS_TV_REFRESHTOKEN=
# NODELINK_SOURCES_YOUTUBE_GETOAUTHTOKEN=false
