# Discord bot credentials
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
# Optional: set this to deploy slash commands to a single guild instantly (faster for testing).
# Leave blank to deploy globally (takes up to 1 hour to propagate).
GUILD_ID=

# Lavalink node connection (point this at your official Lavalink server)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
